{
	"compilerOptions": {
		"strict": true,
		"noEmit": true,
		"allowJs": true,
		"target": "ESNext",
		"module": "ESNext",
		"skipLibCheck": true,
		"moduleResolution": "bundler",
		"types": ["vite/client"],
		"paths": {
			"#/*": ["./src/*"]
		},
		"lib": ["ESNext", "DOM", "DOM.Iterable"]
	},
	"include": ["src"]
}
